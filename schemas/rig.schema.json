{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1
    },
    "bones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": "string"
          },
          "length": {
            "type": "number",
            "minimum": 0
          },
          "sprite": {
            "type": "object",
            "properties": {
              "texture": {
                "type": "string",
                "minLength": 1
              },
              "frame": {
                "type": ["string", "number"]
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "originX": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "originY": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scaleX": {
                "type": "number"
              },
              "scaleY": {
                "type": "number"
              },
              "depth": {
                "type": "number"
              }
            },
            "required": ["texture"],
            "additionalProperties": false
          },
          "depth": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rotation": {
            "type": "number"
          },
          "scaleX": {
            "type": "number"
          },
          "scaleY": {
            "type": "number"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "bone": {
            "type": "string",
            "minLength": 1
          },
          "depth": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rotation": {
            "type": "number"
          },
          "scaleX": {
            "type": "number"
          },
          "scaleY": {
            "type": "number"
          }
        },
        "required": ["id", "bone"],
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "texture": {
            "type": "string",
            "minLength": 1
          },
          "frame": {
            "type": ["string", "number"]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rotation": {
            "type": "number"
          },
          "scaleX": {
            "type": "number"
          },
          "scaleY": {
            "type": "number"
          },
          "originX": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "originY": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": ["id", "texture"],
        "additionalProperties": false
      }
    },
    "skins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slots": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": ["version", "name", "slots"],
        "additionalProperties": false
      }
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["root", "bones", "version"],
  "additionalProperties": false,
  "title": "Paper Puppeteer rig"
}

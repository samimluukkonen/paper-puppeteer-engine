{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!__proto__$)[\\s\\S]+$"
    },
    "bones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "parent": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "length": {
            "type": "number",
            "minimum": 0
          },
          "sprite": {
            "type": "object",
            "properties": {
              "texture": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!__proto__$)[\\s\\S]+$"
              },
              "frame": {
                "type": ["string", "number"]
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "originX": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "originY": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scaleX": {
                "type": "number"
              },
              "scaleY": {
                "type": "number"
              },
              "depth": {
                "type": "number"
              }
            },
            "required": ["texture"],
            "additionalProperties": false
          },
          "depth": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rotation": {
            "type": "number"
          },
          "scaleX": {
            "type": "number"
          },
          "scaleY": {
            "type": "number"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "bone": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "depth": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rotation": {
            "type": "number"
          },
          "scaleX": {
            "type": "number"
          },
          "scaleY": {
            "type": "number"
          }
        },
        "required": ["id", "bone"],
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "texture": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "frame": {
            "type": ["string", "number"]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rotation": {
            "type": "number"
          },
          "scaleX": {
            "type": "number"
          },
          "scaleY": {
            "type": "number"
          },
          "originX": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "originY": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "groundContacts": {
            "readOnly": true,
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "texture"],
        "additionalProperties": false
      }
    },
    "skins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "slots": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!__proto__$)[\\s\\S]+$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!__proto__$)[\\s\\S]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": ["version", "name", "slots"],
        "additionalProperties": false
      }
    },
    "ik": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "rootBone": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "middleBone": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "endBone": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "endOffset": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "target": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "bendDirection": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": -1
              }
            ]
          },
          "mix": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "type": "number"
          }
        },
        "required": ["name", "rootBone", "middleBone", "endBone"],
        "additionalProperties": false
      }
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["root", "bones", "version"],
  "additionalProperties": false,
  "title": "Paper Puppeteer rig"
}

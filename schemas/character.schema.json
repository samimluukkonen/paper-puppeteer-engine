{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!__proto__$)[\\s\\S]+$"
    },
    "rig": {
      "type": "string",
      "minLength": 1
    },
    "defaultSkin": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!__proto__$)[\\s\\S]+$"
    },
    "skins": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!__proto__$)[\\s\\S]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "poses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "textures": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!__proto__$)[\\s\\S]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": ["version", "id", "rig", "defaultSkin", "skins", "animations", "textures"],
  "additionalProperties": false,
  "title": "Paper Puppeteer character manifest"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!__proto__$)[\\s\\S]+$"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "loop": {
      "type": "boolean"
    },
    "interpolation": {
      "type": "string",
      "const": "linear"
    },
    "tracks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!__proto__$)[\\s\\S]+$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "time": {
              "type": "number",
              "minimum": 0
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "rotation": {
              "type": "number"
            },
            "scaleX": {
              "type": "number"
            },
            "scaleY": {
              "type": "number"
            }
          },
          "required": ["time"],
          "additionalProperties": false
        }
      }
    },
    "ikTracks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!__proto__$)[\\s\\S]+$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "time": {
              "type": "number",
              "minimum": 0
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "mix": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["time"],
          "additionalProperties": false
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          "data": {}
        },
        "required": ["time", "name"],
        "additionalProperties": false
      }
    },
    "playback": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "smooth"
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "stepped"
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": ["mode", "fps"],
          "additionalProperties": false
        }
      ]
    },
    "version": {
      "type": "number",
      "const": 1
    }
  },
  "required": ["name", "duration", "loop", "tracks", "version"],
  "additionalProperties": false,
  "title": "Paper Puppeteer animation"
}

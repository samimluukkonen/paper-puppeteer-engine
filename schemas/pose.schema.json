{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!__proto__$)[\\s\\S]+$"
    },
    "bones": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!__proto__$)[\\s\\S]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rotation": {
            "type": "number"
          },
          "scaleX": {
            "type": "number"
          },
          "scaleY": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "library": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!__proto__$)[\\s\\S]+$"
        },
        "characterId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!__proto__$)[\\s\\S]+$"
        },
        "rigSignature": {
          "type": "string",
          "minLength": 1
        },
        "space": {
          "type": "string",
          "const": "fk-local"
        }
      },
      "required": ["id", "characterId", "rigSignature", "space"],
      "additionalProperties": false
    }
  },
  "required": ["version", "name", "bones"],
  "additionalProperties": false,
  "title": "Paper Puppeteer static pose"
}

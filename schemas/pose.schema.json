{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "bones": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rotation": {
            "type": "number"
          },
          "scaleX": {
            "type": "number"
          },
          "scaleY": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "name", "bones"],
  "additionalProperties": false,
  "title": "Paper Puppeteer static pose"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Puppeteer static pose",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "bones"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "bones": { "type": "object", "additionalProperties": { "$ref": "#/$defs/transform" } }
  },
  "$defs": {
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rotation": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" }
      }
    }
  }
}

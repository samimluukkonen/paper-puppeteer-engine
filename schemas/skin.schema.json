{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!__proto__$)[\\s\\S]+$"
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!__proto__$)[\\s\\S]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!__proto__$)[\\s\\S]+$"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": ["version", "name", "slots"],
  "additionalProperties": false,
  "title": "Paper Puppeteer skin"
}

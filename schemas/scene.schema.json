              },
              {
                "pattern": "\\S"
              }
            ]
          },
          "character": {
            "type": "object",
            "properties": {
              "manifest": {
                "type": "string",
                "pattern": "^(?:https?:\\/\\/[^\\s?#\\\\]+|(?!(?:[a-zA-Z][a-zA-Z\\d+.-]*:|\\/\\/))[^\\s:?#\\\\]+)\\.json$"
              }
            },
            "required": ["manifest"],
            "additionalProperties": false
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }

            "required": ["x", "y"],
            "additionalProperties": false
          },
          "facing": {
            "type": "string",
            "enum": ["left", "right"]
          },
          "animation": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "pattern": "^(?!__proto__$)[\\s\\S]+$"
              },
              {
                "pattern": "\\S"
              }

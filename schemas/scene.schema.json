                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": ["x", "y"],
                "additionalProperties": false
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": ["id", "actorId", "time", "type", "destination", "duration"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {

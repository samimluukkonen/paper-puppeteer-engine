                  {
                    "pattern": "^(?!__proto__$)[\\s\\S]+$"
                  },
                  {
                    "pattern": "\\S"
                  }
                ]
              },
              "actorId": {
                "type": "string",
                "minLength": 1,
                "allOf": [
                  {
                    "pattern": "^(?!__proto__$)[\\s\\S]+$"
                  },
                  {
                    "pattern": "\\S"
                  }
                ]

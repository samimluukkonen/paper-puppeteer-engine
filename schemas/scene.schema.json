                "type": "number",
                "exclusiveMinimum": 0
              },
              "loop": {
                "type": "boolean"
              },
              "speed": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": ["id", "actorId", "time", "type", "animation", "duration", "loop", "speed"],
            "additionalProperties": false

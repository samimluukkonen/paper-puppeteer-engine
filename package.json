{
  "name": "paper-puppeteer-engine",
  "version": "1.6.6",
  "description": "A reusable Phaser engine for hierarchical 2D paper cutout puppets.",
  "type": "module",
  "files": [
    "dist/library",
    "src/engine",
    "schemas",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/library/index.js",
  "module": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts",
  "exports": {
    "./core": {
      "types": "./dist/library/core.d.ts",
      "import": "./dist/library/core.js"
    },
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./runtime": {
      "types": "./dist/library/runtime.d.ts",
      "import": "./dist/library/runtime.js"
    },
    "./data": {
      "types": "./dist/library/data.d.ts",
      "import": "./dist/library/data.js"
    },
    "./serialization": {
      "types": "./dist/library/serialization.d.ts",
      "import": "./dist/library/serialization.js"
    }
  },
  "sideEffects": [
    "*.css",
    "./src/main.ts",
    "./src/devtools/**",
    "./src/examples/**",
    "./src/shared/**",
    "./src/ui/**"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:demo && npm run build:lib",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/check-core.mjs",
    "prepack": "npm run check:version && npm run build:lib",
    "pack:dist": "mkdir -p dist && npm pack --pack-destination dist",
    "preview": "vite preview",
    "schemas:generate": "node scripts/generate-schemas.mjs && oxfmt schemas",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "audit": "node scripts/audit.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:demo": "node scripts/check-demo-pages.mjs",
    "check:fix": "npm run lint:fix && npm run format && npm run typecheck",
    "test": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache vitest run",
    "test:watch": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache vitest",
    "test:browser": "npm run build:demo && playwright test",
    "profile:timeline": "node scripts/profile-timeline.mjs",
    "profile:scene": "node scripts/profile-timeline.mjs --scene",
    "profile:project": "node scripts/profile-timeline.mjs --project",
    "test:package": "node scripts/check-package.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && node scripts/check-subscribers.mjs && node scripts/check-project-context.mjs",
    "lint:fix": "oxlint --fix",
    "check:release": "npm run check && npm run check:version && npm run test && npm run build && npm run check:demo && npm run test:package"
  },
  "peerDependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.74.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}

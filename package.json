{
  "name": "paper-puppeteer-engine",
  "version": "0.1.0",
  "description": "A reusable Phaser engine for hierarchical 2D paper cutout puppets.",
  "type": "module",
  "files": ["dist/library", "src/engine", "README.md"],
  "main": "./dist/library/index.js",
  "module": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:demo && npm run build:lib",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {"phaser": "4.2.1"},
  "devDependencies": {
    "phaser": "4.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {"node": "^20.19.0 || >=22.12.0"}
}
